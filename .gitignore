# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Scraper output — regenerable, never commit.
# The database is ~225 MB and its backups are ~113 MB: both are well over
# GitHub's 100 MB per-file limit, and both are rebuilt by `verra sync`.
data/*.db
data/*.db.*
data/*.db-*
data/*.sqlite*
out/*.xlsx
out/*.csv
.cache/
logs/

# Build artifacts: the frozen app, the installer, and the slimmed database it
# ships. All three are rebuilt by build.ps1 from what is committed.
dist/
build/

# The shipped database, when someone running from a checkout drops it here to
# get an instant export instead of a two-hour scrape (see README, "Run it from
# the source"). ~21 MB of regenerable data; `verra slim-db` writes it.
seed/

# Local env
.env

# Per-machine tool state, not project code
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store
